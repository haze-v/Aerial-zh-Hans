        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅日照时段"
          }
        }
      }
    },
    "During daylight keeps the sunrise period right after sunrise and the sunset period right before sunset. Centered splits each period half before, half after the event.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「仅日照时段」将日出时段放在日出之后，日落时段放在日落之前。「以日出和日落为中心」将每个时段均分在对应时刻前后。"
          }
