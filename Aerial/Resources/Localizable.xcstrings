      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略的应用"
          }
        }
      }
    },
    "Ignored apps don't count toward the coverage threshold — useful for tools that keep a transparent window over the screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算遮挡比例时排除这些应用。适用于在屏幕上保留透明窗口的工具。"
          }
        }
      }
    },
