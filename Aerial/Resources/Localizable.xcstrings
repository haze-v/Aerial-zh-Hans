          }
        }
      }
    },
    "Draws a solid band behind the menu bar so its text keeps the same color whatever the video shows. \"Color from video\" picks a tone from the top of each video. Desktop only; hidden when the menu bar is set to hide automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏后绘制纯色背景，让文字颜色保持一致。「取色视频」从每个视频顶部取色。仅适用于桌面，菜单栏设为自动隐藏时不显示。"
          }
        }
      }
    },
    "Drive not connected — plug it in to convert.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘未连接。请连接后再转换。"
          }
        }
      }
