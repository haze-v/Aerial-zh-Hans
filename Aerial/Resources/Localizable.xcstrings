{
  "sourceLanguage": "en",
  "strings": {
    "\"On any battery power\" pauses as soon as the charger is unplugged. \"Only when battery is low\" waits until the remaining capacity drops below 20%.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择「使用电池时」会在拔掉电源后立即暂停。选择「仅在电量不足时」会在剩余电量低于 20% 时暂停。"
          }
        }
      }
    },
    "%@ ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@前"
          }
        }
      }
    },
    "%@ is already in your library — nothing new to add.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库中已有 %@，无需重复添加。"
          }
        }
      }
    },
    "%@ videos will play as fallback": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将播放 %@ 视频作为备选"
          }
        }
      }
    },
    "%@ → %@ in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 将在 %3$@ 后切换到 %2$@"
          }
        }
      }
    },
    "%@, not downloaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，尚未下载"
          }
        }
      }
    },
    "%lld %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@"
          }
        }
      }
    },
    "%lld Videos Selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %lld 个视频"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 项，共 %lld 项"
          }
        }
      }
    },
    "%lld packs from this link are already in your library — nothing new to add.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此链接中的 %lld 个扩展包已在资料库中。"
          }
        }
      }
    },
    "%lld pt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 磅"
          }
        }
      }
    },
    "%lld seconds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        }
      }
    },
    "%lld video%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个视频%@"
          }
        }
      }
    },
    "%llds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        }
      }
    },
    "(hardcoded)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（固定）"
          }
        }
      }
    },
    "- **Location Services** : Aerial can use your position to show Weather forecasts, and to calculate your local sunset/sunrise times to adapt the content that plays.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "- **定位服务**：Aerial 可以使用你的位置显示天气预报，并计算当地的日出和日落时间，以调整播放内容。"
          }
        }
      }
    },
    "0.125× (default)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0.125 倍（默认）"
          }
        }
      }
    },
    "1.0× (native)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1.0 倍（原速）"
          }
        }
      }
    },
    "A free, open-source macOS screen saver and video wallpaper app, made and maintained by Guillaume Louel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Guillaume Louel 开发和维护的免费开源 macOS 屏幕保护程序和动态墙纸应用。"
          }
        }
      }
    },
    "A new version of Aerial is available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 有新版本可用"
          }
        }
      }
    },
    "ACTIONS": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About Aerial": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Aerial"
          }
        }
      }
    },
    "Access not yet granted — the cleaner can't run until you allow it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授予访问权限。授权后才能清理。"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Activation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动方式"
          }
        }
      }
    },
    "Activation & playback": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动与播放"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add %lld Videos to Playlist": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 %lld 个视频到播放列表"
          }
        }
      }
    },
    "Add %lld to Playlist": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 %lld 个视频到播放列表"
          }
        }
      }
    },
    "Add Live Feed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加实时源"
          }
        }
      }
    },
    "Add to New Playlist": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到新播放列表"
          }
        }
      }
    },
    "Add to New Playlist...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到新播放列表…"
          }
        }
      }
    },
    "Add to Playlist": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到播放列表"
          }
        }
      }
    },
    "Add to favorites": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到收藏"
          }
        }
      }
    },
    "Adjustable any time in Settings → Overlays.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时在「设置 → 叠加内容」中调整。"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "Advanced per-display margins": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各显示器边距"
          }
        }
      }
    },
    "Advanced — manage installed sources": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级：管理已安装的来源"
          }
        }
      }
    },
    "Advances the playlist on all displays at the chosen interval — even while paused or auto-paused, so a paused wallpaper doesn't show the same frame forever.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按所选间隔切换所有显示器上的视频。即使暂停，墙纸画面也会定时更新。"
          }
        }
      }
    },
    "Aerial 4 Wallpaper": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 4 墙纸"
          }
        }
      }
    },
    "Aerial 4 can look for old files from previous versions for migration and/or cleanup. macOS will ask you to give permission for this. I **highly recommend** you do if you used a previous version.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 4 可以查找旧版本的文件以便迁移或清理。macOS 会请求访问权限。如果用过旧版本，建议允许访问。"
          }
        }
      }
    },
    "Aerial 4 doesn't collect **any** telemetry or data of any kind. In order to work *locally*, some optional features will ask for system a permission, but **always** provide an alternative :": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 4 不收集**任何**遥测信息或其他数据。部分可选功能需要系统权限才能在本地运行，也提供了其他使用方式："
          }
        }
      }
    },
    "Aerial 4 is ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 4 已就绪"
          }
        }
      }
    },
    "Aerial Data Migration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 数据迁移"
          }
        }
      }
    },
    "Aerial Discord": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 的 Discord 社区"
          }
        }
      }
    },
    "Aerial Dock icon preview": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 程序坞图标预览"
          }
        }
      }
    },
    "Aerial Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 设置"
          }
        }
      }
    },
    "Aerial Website": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 网站"
          }
        }
      }
    },
    "Aerial can sit in your menu bar as a compact popover, or run as a regular app in the Dock with the Video Library as its main window. You can switch any time in Settings → Advanced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 可以在菜单栏显示简洁面板，也可以作为程序坞应用，以视频资料库为主窗口。可随时在「设置 → 高级」切换。"
          }
        }
      }
    },
    "Aerial in your Dock": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序坞中显示 Aerial"
          }
        }
      }
    },
    "Aerial is free and open source. Expansions are extra video packs from independent artists — some are free, others are paid. Buying a paid expansion supports both the creator and Aerial's continued development. It's how we keep the project moving without ads or telemetry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 免费开源。扩展包由独立创作者提供，有免费和付费内容。购买付费扩展包可支持创作者和 Aerial 项目。"
          }
        }
      }
    },
    "Aerial isn't set as your screensaver yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未将 Aerial 设为屏幕保护程序。"
          }
        }
      }
    },
    "Aerial isn't set as your wallpaper yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未将 Aerial 设为墙纸。"
          }
        }
      }
    },
    "Aerial keeps caches outside /Users/Shared in a disk image so the wallpaper extension can play them. Nothing plays on the desktop until this folder is converted. The videos in it are moved into the image; nothing is deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 将 /Users/Shared 之外的缓存存入磁盘映像，供墙纸扩展读取。转换文件夹后，桌面才能播放。视频会移入映像，原有内容不会被删除。"
          }
        }
      }
    },
    "Aerial menu bar popover preview": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 菜单栏面板预览"
          }
        }
      }
    },
    "Aerial runs as your screensaver via the wallpaper extension.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 通过墙纸扩展运行屏幕保护程序。"
          }
        }
      }
    },
    "Aerial still appears to be set as the desktop wallpaper; this option takes effect once it isn't.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerial 仍设为桌面墙纸。更换墙纸后，此选项才会生效。"
          }
        }
      }
    },
    "All Displays": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示器"
          }
        }
      }
    },
    "All Fonts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有字体"
          }
        }
      }
    },
    "All Videos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有视频"
          }
        }
      }
    },
    "All displays": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示器"
          }
        }
      }
    },
    "All displays mirror the same video (alternates flipped).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各显示器镜像播放同一个视频，相邻屏幕画面翻转。"
          }
        }
      }
    },
    "All displays show the same video.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示器同步播放同一个视频。"
          }
        }
      }
    },
    "All displays — %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示器：%@"
          }
        }
      }
    },
    "All playlist videos will play as fallback": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将播放列表中的所有视频作为备选"
          }
        }
      }
    },
    "All screens": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有屏幕"
          }
        }
      }
    },
    "All selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已全选"
          }
        }
      }
    },
    "Already installed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装"
          }
        }
      }
    },
    "Already playing on %@ — Shift-click to play it on another display": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在 %@ 上播放。按住 Shift 点击可在其他显示器上播放。"
          }
        }
      }
    },
    "Also store Expansion packs at this location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时在此位置保存扩展包"
          }
        }
      }
    },
    "Alternatively, give Aerial **Full Disk Access** in System Settings › Privacy & Security, then come back and click **Check Again** (quit and reopen Aerial if it still fails).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以在「系统设置 → 隐私与安全性」中授予 Aerial **完全磁盘访问权限**，然后返回点击**重新检查**。若仍然失败，请退出并重新打开 Aerial。"
          }
        }
      }
    },
    "Always show version (debug)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终显示版本（调试）"
          }
        }
      }
    },
    "Any Time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意时段"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Apps covering the wallpaper": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遮挡墙纸的应用"
          }
        }
      }
    },
    "Ask again next time Aerial starts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次启动时再询问"
          }
        }
      }
    },
    "Aspect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽高比"
          }
        }
      }
    },
    "At login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时"
          }
        }
      }
    },
    "Attaching…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在挂载…"
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频"
          }
        }
      }
    },
    "Auto Updates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动更新"
          }
        }
      }
    },
    "Auto install updates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动安装更新"
          }
        }
      }
    },
    "Auto-Advance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动切换"
          }
        }
      }
    },
    "Auto-Pause": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动暂停"
          }
        }
      }
    },
    "Automatically clean wallpaper cache": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动清理墙纸缓存"
          }
        }
      }
    },
    "Automatically download videos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动下载视频"
          }
        }
      }
    },
    "Automatically pauses the wallpaper while this Mac reports serious thermal pressure (fans at full tilt), and resumes once it cools down.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 温度过高时暂停墙纸，降温后自动继续。"
          }
        }
      }
    },
