        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用电池时暂停"
          }
        }
      }
    },
    "Pause playback when this percentage of the screen is covered by windows. Lower values pause sooner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口遮挡屏幕达到此比例时暂停播放。比例越低，越容易触发暂停。"
          }
        }
      }
    },
    "Pause stops every Aerial 4 renderer (timebase rate 0). Resume restores the configured speed. Pause is global — the toggle affects all displays.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停会停止所有 Aerial 4 播放器。继续播放时恢复设定速度。此开关控制所有显示器。"
          }
        }
      }
    },
    "Pause the wallpaper": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停墙纸"
          }
        }
      }
    },
    "Pause the wallpaper (static frame)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停墙纸（定格画面）"
          }
        }
      }
    },
    "Pause this display": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停此显示器"
          }
        }
      }
    },
    "Pause under thermal pressure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度过高时暂停"
          }
        }
